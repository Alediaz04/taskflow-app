{
  "expo": {
    "name": "taskflow-app",
    "slug": "taskflow-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.taskflowapp"
    },
    "android": {
      "package": "com.anonymous.taskflowapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "TaskFlow necesita acceso a tus fotos para que elijas una imagen de perfil."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "f60904e4-3844-49d5-9125-0f860c6e85a6"
      }
    },
    "owner": "alediazdev"
  }
}
